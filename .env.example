# STUFFS Mission Control — server-side secrets.
# Copy to .env.local (never committed). All of these stay on the server;
# nothing here is ever sent to the browser.

# --- Notion (system of record) ---
# Internal integration token: https://www.notion.so/my-integrations
NOTION_TOKEN=
# The page the provisioning script creates all databases under.
# Share that page with your integration, then paste its ID here.
NOTION_PARENT_PAGE_ID=

# --- Printify (owns listing creation; read-only catalog access in Phase 1) ---
# Personal access token: Printify → My Profile → Connections
PRINTIFY_API_TOKEN=

# --- Anthropic (Design Tool — Capture mode: reference image → Style record) ---
# API key from console.anthropic.com → API Keys. Note this is API billing
# (pay per use), separate from any Claude.ai subscription.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5.
# ANTHROPIC_MODEL=

# --- Etsy ---
# Writes (listing optimisation) are still stubbed — v1 is draft-only. The
# only valid values are: draft-only | preview-approve. preview-approve is
# deferred and will throw if selected.
ETSY_PUBLISH_MODE=draft-only
# App Keystring from etsy.com/developers → your app → Keystring.
ETSY_KEYSTRING=
# Shared Secret from the same page. REQUIRED: since Etsy's Feb 2026 change,
# every v3 call's x-api-key header must carry "<keystring>:<shared secret>"
# together — the Keystring alone returns 403. Both must be set for the
# Connect Etsy button (Today page) to work.
ETSY_SHARED_SECRET=
# Once ETSY_KEYSTRING is set, register this exact URL as the app's callback
# on etsy.com/developers → your app → Settings, then use the Connect Etsy
# button — no separate env var needed, it's derived from the request:
#   https://<your-deployed-domain>/api/etsy/oauth/callback

# --- Google Drive (mockup auto-import; read-only) ---
# OAuth client (Web application) from console.cloud.google.com → Credentials.
# Authorized redirect URI: https://<your-deployed-domain>/api/drive/oauth/callback
# Scope drive.readonly. While the app is in Testing mode, Google expires the
# connection ~weekly — the Library page offers a one-click reconnect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Local cache (SQLite). Point at a persistent volume in production. ---
CACHE_DB_PATH=./data/cache.db

# --- Optional: single shared password (HTTP Basic auth) for the deployed app ---
# Leave empty to disable. Solo-operator tool; put real auth at the proxy layer
# (Cloudflare Access etc.) if you prefer.
APP_PASSWORD=
